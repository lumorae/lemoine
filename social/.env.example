# Lemoine social system — environment template
# Copy to .env (which is gitignored) OR, preferably, store these as
# Supabase project secrets / Vercel environment variables.
# NEVER commit real values.

# --- Meta / Instagram (Graph API) ---
IG_BUSINESS_ACCOUNT_ID=          # numeric IG Business Account ID
IG_PAGE_ACCESS_TOKEN=            # long-lived Page access token
META_APP_ID=
META_APP_SECRET=

# --- LinkedIn (Community Management API) ---
LINKEDIN_ORG_URN=                # e.g. urn:li:organization:12345678
LINKEDIN_ACCESS_TOKEN=           # OAuth access token with w_organization_social, r_organization_social, rw_organization_admin
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Supabase (engine + warehouse) ---
SUPABASE_URL=https://eiqcjfjlpleitwjzwgjd.supabase.co
SUPABASE_SERVICE_ROLE_KEY=       # server-side only, never ship to a browser

# --- Airtable (cockpit) ---
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=                # base ID for the Content base (created during setup)
AIRTABLE_TABLE_NAME=Posts
